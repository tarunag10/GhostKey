{
  "name": "ghostkey",
  "version": "1.0.0",
  "private": true,
  "description": "Browser extension that suppresses intrusive login popups and restores page usability",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:chrome": "node scripts/build-chrome.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:rules": "node scripts/validate-rules.mjs",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.20.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0",
    "jsdom": "^24.0.0",
    "@types/chrome": "^0.0.268"
  }
}
